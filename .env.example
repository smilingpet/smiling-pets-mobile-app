# ─────────────────────────────────────────────────────────────
# Smiling Pets PWA — Environment Variables
# Copy this file to ".env.local" for local development, and add
# the same three variables inside your Vercel Project Settings →
# Environment Variables for Production/Preview/Development.
# NEVER commit a file containing real values to GitHub.
# ─────────────────────────────────────────────────────────────

# Your Shopify store's *.myshopify.com domain (no https://, no trailing slash)
# Example: smiling-pets.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API PRIVATE access token generated from a Shopify Headless
# channel (Shopify Admin → Settings → Apps and sales channels → Headless
# → your app → Storefront API → "Storefront API access token" — use the
# PRIVATE token, not the public one). This token is sent server-side only,
# using the "Shopify-Storefront-Private-Token" header (never the public
# "X-Shopify-Storefront-Access-Token" header, and never exposed to the
# browser — see src/lib/shopify/client.ts). This app targets Storefront
# API version 2026-07 (see API_VERSION in src/lib/shopify/client.ts).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public URL this app is deployed at, used for canonical tags, the
# manifest, Open Graph tags, and the sitemap. Update after you get your
# Vercel URL or connect a custom domain.
# Example: https://app.smilingpets.in or https://smiling-pets.vercel.app
NEXT_PUBLIC_SITE_URL=https://smiling-pets.vercel.app

# ─────────────────────────────────────────────────────────────
# Optional — analytics (leave blank until you are ready to enable)
# See src/lib/analytics/config.ts. No tracking script loads unless
# these are set, and each script is only ever added once.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────
# Optional — used only by the /api/revalidate webhook endpoint so
# Shopify can tell the app to refresh cached product/collection data
# the instant something changes in Shopify Admin. Generate any long
# random string yourself, e.g. with `openssl rand -hex 32`.
# ─────────────────────────────────────────────────────────────
SHOPIFY_REVALIDATION_SECRET=
